Emscripten browser HTTP transport for the DoltLite remote client.

- native builds reach a dolt remote via BSD sockets + (for https) mbedTLS;
  neither exists inside a WebAssembly page
- on Emscripten, routes every request through the browser's own networking via
  the synchronous Emscripten Fetch API instead
- only the byte transport under httpRequest() changes; sync algorithm and
  status-code handling are untouched
- https is permitted on Emscripten too (browser-terminated TLS, no mbedTLS);
  the capability URL carries authorization, so no bearer-token layer is needed
- requires linking the final module with -sFETCH=1
- guarded entirely by __EMSCRIPTEN__, so native/other targets are byte-identical

diff --git a/doltlite.c b/doltlite.c
index 81a8e2e..c64fe97 100644
--- a/doltlite.c
+++ b/doltlite.c
@@ -331932,6 +331932,85 @@ static int readUntilEof(HttpConn *conn, u8 **ppOut, int *pnOut){
   return SQLITE_OK;
 }
 
+#if defined(__EMSCRIPTEN__)
+#include <emscripten/fetch.h>
+
+/* Browser transport (BSD sockets/mbedTLS don't exist in a WebAssembly page):
+** - routes each request through the browser's synchronous Emscripten Fetch API
+** - only the byte transport changes; sync algorithm and status handling don't
+** - capability URL carries auth, so no bearer-token header is needed here
+** - TLS is browser-terminated, so https needs no mbedTLS
+** - response is copied out by explicit length, preserving embedded NULs
+** - HTTP status is returned verbatim for the callers' existing status mapping
+** - requires linking the final module with -sFETCH=1 */
+static int httpRequestFetch(
+  HttpRemote *p,
+  const char *zMethod,
+  const char *zPath,
+  const u8 *pBody, int nBody,
+  int *pStatus,
+  u8 **ppResp, int *pnResp
+){
+  emscripten_fetch_attr_t attr;
+  emscripten_fetch_t *fetch;
+  char *zUrl;
+  const char *zScheme = p->useTls ? "https" : "http";
+  const char *aHdr[3];
+
+  if( p->useTls ? (p->port==443) : (p->port==80) ){
+    zUrl = sqlite3_mprintf("%s://%s%s", zScheme, p->zHost, zPath);
+  }else{
+    zUrl = sqlite3_mprintf("%s://%s:%d%s", zScheme, p->zHost, p->port, zPath);
+  }
+  if( !zUrl ) return SQLITE_NOMEM;
+
+  emscripten_fetch_attr_init(&attr);
+  sqlite3_snprintf(sizeof(attr.requestMethod), attr.requestMethod, "%s", zMethod);
+  attr.attributes = EMSCRIPTEN_FETCH_LOAD_TO_MEMORY
+                  | EMSCRIPTEN_FETCH_SYNCHRONOUS
+                  | EMSCRIPTEN_FETCH_REPLACE;
+
+  if( pBody && nBody > 0 ){
+    aHdr[0] = "Content-Type";
+    aHdr[1] = "application/octet-stream";
+    aHdr[2] = 0;
+    attr.requestHeaders = aHdr;
+    attr.requestData = (const char*)pBody;
+    attr.requestDataSize = (size_t)nBody;
+  }
+
+  fetch = emscripten_fetch(&attr, zUrl);
+  sqlite3_free(zUrl);
+  if( !fetch ) return SQLITE_ERROR;
+
+  /* status 0: transport-level failure (unreachable host, CORS block, bad URL),
+  ** never a real HTTP server response. 4xx/5xx are completed exchanges and
+  ** pass through unchanged. */
+  if( fetch->status==0 ){
+    emscripten_fetch_close(fetch);
+    return SQLITE_ERROR;
+  }
+  *pStatus = (int)fetch->status;
+
+  if( fetch->data && fetch->numBytes>0 ){
+    if( fetch->numBytes > (uint64_t)HTTP_RESP_MAX_BYTES ){
+      emscripten_fetch_close(fetch);
+      return SQLITE_TOOBIG;
+    }
+    *ppResp = sqlite3_malloc((int)fetch->numBytes);
+    if( !*ppResp ){
+      emscripten_fetch_close(fetch);
+      return SQLITE_NOMEM;
+    }
+    memcpy(*ppResp, fetch->data, (size_t)fetch->numBytes);
+    *pnResp = (int)fetch->numBytes;
+  }
+
+  emscripten_fetch_close(fetch);
+  return SQLITE_OK;
+}
+#endif /* __EMSCRIPTEN__ */
+
 static int httpRequest(
   HttpRemote *p,
   const char *zMethod,
@@ -331951,6 +332030,9 @@ static int httpRequest(
   *ppResp = 0;
   *pnResp = 0;
 
+#if defined(__EMSCRIPTEN__)
+  return httpRequestFetch(p, zMethod, zPath, pBody, nBody, pStatus, ppResp, pnResp);
+#else
   conn = httpConnOpen(p->zHost, p->port, p->useTls);
   if( !conn ) return SQLITE_ERROR;
 
@@ -332071,6 +332153,7 @@ static int httpRequest(
   }
 
   return SQLITE_OK;
+#endif /* !__EMSCRIPTEN__ */
 }
 
 static int uploadBufAppend(HttpRemote *p, const u8 *pData, int nData){
@@ -332463,9 +332546,12 @@ DoltliteRemote *doltliteHttpRemoteOpen(const char *zUrl){
   if( !zUrl ) return 0;
 
   if( strncmp(zUrl, "https://", 8) == 0 ){
-#ifndef DOLTLITE_HAVE_AUTH
+#if !defined(DOLTLITE_HAVE_AUTH) && !defined(__EMSCRIPTEN__)
     return 0;
 #else
+    /* On Emscripten the browser terminates TLS and the transport routes through
+    ** Emscripten Fetch, so https is allowed even without the native mbedTLS
+    ** stack (DOLTLITE_HAVE_AUTH is off on wasm targets). */
     useTls = 1;
     port = 443;
     zAfterScheme = zUrl + 8;
