+  if( cs->staging.nRecentUncommitted==0
+   && (csDiskStateMatchesMemory(cs) || cs->bTrustLocalAfterCommit) ){
+    cs->bTrustLocalAfterCommit = 0;
     return SQLITE_OK;
   }
+  cs->bTrustLocalAfterCommit = 0;
