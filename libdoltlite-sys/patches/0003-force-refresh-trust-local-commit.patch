@@ -277295,6 +277319,7 @@ int chunkStoreCommit(ChunkStore *cs){
     acquiredLock = 1;
   }
   rc = csCommitToFile(cs);
+  if( rc==SQLITE_OK ) cs->bTrustLocalAfterCommit = 1;
   if( acquiredLock ) chunkStoreUnlock(cs);
   return rc;
 }
@@ -277484,9 +277509,12 @@ int chunkStoreForceRefresh(ChunkStore *cs){
   ** matches this handle's state, the reload — which replays the entire WAL —
